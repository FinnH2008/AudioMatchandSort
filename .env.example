# =============================================================================
# TonArchiv — Homeserver Docker Konfiguration (.env.example)
# Kopiere diese Datei nach .env:
#   cp .env.example .env
# Alle API-Keys sind optional — fehlende Keys deaktivieren nur die jeweilige
# Stufe mit klarem Hinweis, statt den Container abstuerzen zu lassen.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server, Port & Host-Pfade
# -----------------------------------------------------------------------------
# Port auf dem Homeserver, ueber den das Web-Dashboard erreichbar ist
TONARCHIV_PORT=7070

# Host-Pfad zu deiner Musikbibliothek (genau EIN Mount fuer atomares Verschieben!)
HOST_MUSIC_DIR=/srv/Music Full Quality
# Pfad innerhalb des Containers
MUSIC_DIR=/srv/Music Full Quality

# Persistenter Konfigurationsordner (SQLite-Cache cache.db + Journal rollback.json)
HOST_CONFIG_DIR=./config
CONFIG_DIR=/config

# Benutzer- & Gruppen-ID auf dem Host (auf Linux/NAS mit `id -u` und `id -g` pruefen)
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# 2. Externe API-Keys (optional, alle kostenlos erhaeltlich)
# -----------------------------------------------------------------------------
# AcoustID API-Key (Chromaprint Audio-Fingerprinting):
# Kostenlos erstellen unter: https://acoustid.org/new-application
ACOUSTID_API_KEY=

# Discogs Personal Access Token (Vinyl-, Club- & EP-Releases):
# Kostenlos erstellen unter: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# MusicBrainz User-Agent Kontakt (kein API-Key noetig! Optional E-Mail/URL eintragen)
MUSICBRAINZ_CONTACT=

# Hinweis: MusicBrainz, Cover Art Archive, LRCLIB (Songtexte) & Deezer
# benoetigen KEINEN API-Key.

# -----------------------------------------------------------------------------
# 3. Optionale Module
# -----------------------------------------------------------------------------
# ShazamIO Fallback (inoffizielle API — fuer unbekannte Remixes/Edits)
ENABLE_SHAZAMIO=true

# Essentia Audio-Analyse (Key, BPM, Spektral-Cutoff-Heuristik; benoetigt mehr RAM/Build-Zeit)
ENABLE_ESSENTIA=false

# -----------------------------------------------------------------------------
# 4. Qualitaet, Konfidenz, DJ-Remixes & Review-Verhalten
# -----------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.80
MIN_LOSSY_BITRATE=256
SEPARATE_LOW_QUALITY_LOSSY=true
MIXED_ALBUM_STRATEGY=lowest_quality
DJ_REMIX_LAYOUT=root_folder
ENRICH_REMIX_EMPTY_FIELDS=true
KEEP_REVIEW_IN_PLACE=false

# -----------------------------------------------------------------------------
# 5. Metadaten, Cover, Songtexte & WAV-Schutz
# -----------------------------------------------------------------------------
KEY_FORMAT=both
EMBED_COVER=true
COVER_MAX_SIZE=1000
SAVE_FOLDER_COVER_JPG=true
OVERWRITE_EXISTING_COVER=false
FETCH_LYRICS=true
PREFER_SYNCED_LRC=true
EMBED_LYRICS_IN_FILE=true
WRITE_LRC_SIDECAR=false
WRITE_REPLAYGAIN=true
# Standardmaessig aus, da eingebettete Cover/Lyrics in WAV-Dateien oft unzuverlaessig sind
WAV_EMBED_MEDIA=false

# -----------------------------------------------------------------------------
# 6. Dateisystem- & SMB-Sicherheit
# -----------------------------------------------------------------------------
SMB_CASE_SAFE=true
MAX_PATH_LENGTH=240
MOVE_COMPANION_FILES=true
CLEANUP_EMPTY_DIRS=true
