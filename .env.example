# =============================================================================
# TonArchiv — Produktions-Konfiguration (.env)
# In Portainer einfach diese Variablen unter "Environment variables" eintragen
# oder lokal als .env neben docker-compose.yml speichern.
# =============================================================================

# --- Fertiges Docker-Image (wird automatisch via GitHub Actions auf GHCR gebaut) ---
TONARCHIV_IMAGE=ghcr.io/finnh2008/audiomatchandsort:latest

# --- Web-UI Port ---
TONARCHIV_PORT=7070

# --- Autostart (false = Web-UI startet sofort; true = Read-Only Analyse direkt beim Booten) ---
AUTO_ANALYZE_ON_START=false

# --- Pfade & Dateirechte (id -u / id -g auf dem Homeserver) ---
HOST_MUSIC_DIR=/srv/Music Full Quality
MUSIC_DIR=/music
CONFIG_DIR=/config
PUID=1000
PGID=1000

# --- API-Keys & Kontakt (alle optional, aber sehr empfohlen) ---
# 1. AcoustID (kostenlos): https://acoustid.org/new-application
#    Fuer Audio-Fingerprinting (Chromaprint/fpcalc) bei fehlenden/kaputten Tags
ACOUSTID_API_KEY=

# 2. Discogs Personal Access Token (kostenlos): https://www.discogs.com/settings/developers
#    Fuer DJ-Remixes, Club-12-Inch-Releases und elektronische Kataloge
DISCOGS_TOKEN=

# 3. MusicBrainz Kontakt (kein Key noetig — nur E-Mail oder Repo-URL fuer den User-Agent)
MUSICBRAINZ_CONTACT=mailto:deine-email@beispiel.de

# Hinweis: MusicBrainz, Cover Art Archive und LRCLIB funktionieren komplett OHNE API-Key.

# --- Erkennungsquellen & Analyse ---
ENABLE_SHAZAMIO=true
ENABLE_ESSENTIA=false
CONFIDENCE_THRESHOLD=0.80

# --- Qualitaet, Codecs & Ordner-Regeln ---
MIN_LOSSY_BITRATE=256
SEPARATE_LOW_QUALITY_LOSSY=true
MIXED_ALBUM_STRATEGY=lowest_quality
DJ_REMIX_LAYOUT=root_folder
ENRICH_REMIX_EMPTY_FIELDS=true
KEEP_REVIEW_IN_PLACE=false

# --- Tagging, Cover, Songtexte & Sicherheit ---
KEY_FORMAT=both
EMBED_COVER=true
COVER_MAX_SIZE=1000
SAVE_FOLDER_COVER_JPG=true
OVERWRITE_EXISTING_COVER=false
FETCH_LYRICS=true
PREFER_SYNCED_LRC=true
EMBED_LYRICS_IN_FILE=true
WRITE_LRC_SIDECAR=false
WRITE_REPLAYGAIN=true
WAV_EMBED_MEDIA=false
SMB_CASE_SAFE=true
MAX_PATH_LENGTH=240
MOVE_COMPANION_FILES=true
CLEANUP_EMPTY_DIRS=true
